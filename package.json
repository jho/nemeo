{
  "name": "nemeo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx watch src/interfaces/http/main.ts",
    "dev:web": "vite --host",
    "build": "npm run build:api && npm run build:web && npm run contracts:build",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "start": "node dist/src/interfaces/http/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "contracts:build": "tsp compile contracts && prettier --write contracts/generated/openapi.yaml",
    "contracts:check": "npm run contracts:build && git diff --exit-code -- contracts/generated",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'web/**/*.html' 'contracts/generated/**/*.yaml' contracts/tspconfig.yaml package.json tsconfig.json vite.config.ts vitest.config.ts playwright.config.ts eslint.config.mjs .prettierrc.json",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "validate": "npm run typecheck && npm run contracts:build && npm run lint && npm run format:check && npm run test:unit"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typespec/compiler": "^1.17.0",
    "@typespec/http": "^1.17.0",
    "@typespec/openapi3": "^1.17.0",
    "@typespec/rest": "^0.87.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
